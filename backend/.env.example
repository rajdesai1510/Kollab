# ════════════════════════════════════════════════════════════
#  CollabSpace Backend — Environment Variables
#  Copy this file to .env.development / .env.staging / .env.production
#  NEVER commit real secrets to version control
# ════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# Application Environment
# Options: development | staging | production
# ─────────────────────────────────────────
APP_ENV=development
APP_NAME=CollabSpace
DEBUG=true

# ─────────────────────────────────────────
# Database — MongoDB Atlas
# Development: use local Docker MongoDB URL below
# Staging/Production: use Atlas connection string from Atlas dashboard
# ─────────────────────────────────────────
# Development (local Docker):
MONGODB_URL=mongodb://admin:local_dev_password@localhost:27017/collabspace_dev?authSource=admin
# Staging:
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster-staging.mongodb.net/collabspace_staging?retryWrites=true&w=majority
# Production:
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster-prod.mongodb.net/collabspace_production?retryWrites=true&w=majority

MONGODB_DB_NAME=collabspace_dev

# ─────────────────────────────────────────
# Cache + Sessions — Redis (Upstash in staging/prod)
# Development: use local Docker Redis URL below
# ─────────────────────────────────────────
# Development (local Docker):
REDIS_URL=redis://:local_redis_password@localhost:6379/0
# Upstash (staging/production):
# REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

# Celery uses Redis as broker
CELERY_BROKER_URL=redis://:local_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:local_redis_password@localhost:6379/2

# ─────────────────────────────────────────
# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ─────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters_long_change_this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────
# Google OAuth 2.0
# Setup: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs: http://localhost:8000/api/auth/google/callback
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─────────────────────────────────────────
# Meta / Instagram Graph API
# Setup: https://developers.facebook.com → My Apps → Create App
# Product: Instagram Basic Display API
# Valid OAuth Redirect URIs: http://localhost:8000/api/auth/instagram/callback
# ─────────────────────────────────────────
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback

# ─────────────────────────────────────────
# Frontend URLs (used for CORS and OAuth redirects)
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Staging:  https://collabspace-staging.vercel.app
# Production: https://collabspace.in

# ─────────────────────────────────────────
# Encryption Key (for storing Instagram access tokens in DB)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ─────────────────────────────────────────
# File Storage — Cloudflare R2 (S3-compatible)
# Setup: https://dash.cloudflare.com → R2 → Create Bucket
# Leave empty in development — files saved locally to /uploads
# ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=collabspace-dev
R2_PUBLIC_URL=

# ─────────────────────────────────────────
# Email — Resend
# Setup: https://resend.com → API Keys
# Leave empty in development — emails logged to console only
# ─────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@collabspace.in
FROM_NAME=CollabSpace

# ─────────────────────────────────────────
# Error Tracking — Sentry
# Leave empty in development — errors logged to console
# ─────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────
# Rate Limiting (requests per minute per IP)
# ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
